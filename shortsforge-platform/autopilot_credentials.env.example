# ShortsForge Master Environment Configuration
# Save this file as '.env' in the root folder (d:\Projects\shortsforge-platform\.env)
# Do NOT share this file or upload it to GitHub.

# ==============================================================================
# 1. API Keys (Required for Content Generation)
# ==============================================================================
# Gemini is the primary AI brain for scraping, polishing, and filtering
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) If you use Cerebras or Groq as fallbacks
CEREBRAS_API_KEY=your_cerebras_key_here
GROQ_API_KEY=your_groq_key_here
# ==============================================================================
# 2. Security & Database
# ==============================================================================
# The master key used to encrypt your YouTube OAuth Tokens in the database.
# Do NOT lose this key, or you will have to re-authenticate all YouTube channels.
# You can generate a random secure string using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_secure_encryption_key_here

# ==============================================================================
# 3. Autopilot Notifications & Backups (Optional)
# ==============================================================================
# These credentials power the Master Autopilot daily reports and crash alerts.
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_digit_google_app_password
ALERT_EMAIL=where_to_send_alerts@gmail.com

# If using Google Drive Backups, provide the ID of the folder here.
# (The ID is the long string of letters/numbers in the Google Drive URL).
DRIVE_BACKUP_FOLDER_ID=your_google_drive_folder_id